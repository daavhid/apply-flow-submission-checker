{
  "name": "submission-quality-checker-backend",
  "version": "1.0.0",
  "description": "Local test backend & live monitoring server for Submission Quality Checker extension",
  "main": "server/server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node init && node server/server.js",
    "dev": "node init && node --watch server/server.js",
    "build": "node init && node build-extension.js",
    "build:extension": "node init && node build-extension.js",
    "test:ping": "node -e \"fetch('http://localhost:3000/api/health').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "build:sqc": "node init && node build-extension.js --profile=sqc",
    "build:qa": "node init && node build-extension.js --profile=qa",
    "build:all": "node init && node build-extension.js --all",
    "test:qa": "node --test tests/qa-*.test.js",
    "test:browser": "node tests/browser-qa-smoke.js",
    "test:browser:sqc": "node tests/browser-qa-smoke.js --sidebar"
  },
  "keywords": [
    "ats",
    "submission-checker",
    "chrome-extension",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.3.289"
  }
}
